# Upstream API root. Routes hit ${BASE_URL}/events/scan (POST) and ${BASE_URL}/admin/stampstore/markexchanged (PATCH).
BASE_URL=

# HS256 secret used to mint the short-lived admin JWT sent upstream. Must match the upstream API's signing secret.
JWT_ACCESS_SECRET=

# The upstream user _id (MongoDB) whose role is 'admin'. Embedded as sub in the minted JWT.
SCAN_ADMIN_SUB=

# Display name for the minted admin JWT ("Scanner" if unset).
SCAN_ADMIN_NICKNAME=

# Master switch for the recently-added "scan a bare UUID v7" feature (false if unset). Mirrors the upstream's own flag.
ALLOW_RAW_UUID_SCAN=

# Event list (data/events.json)
# The event dropdown is sourced from data/events.json (read by app/api/events/route.ts), cached in memory and refreshed whenever the file's mtime changes. Shape:

#{
#  "events": [
#    { "event_id": "abc123", "activity_name": "Workshop A" },
#    { "event_id": "def456", "activity_name": "Booth B" }
#  ]
#}
